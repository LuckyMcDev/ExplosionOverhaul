  },
  "license": "Apache License 2.0",
  "icon": "assets/explosionoverhaul/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.luckydev.explosionoverhaul.fabric.ExplosionOverhaulFabric"
    ],
    "client": [
      "de.luckydev.explosionoverhaul.fabric.ExplosionOverhaulFabricClient"
    ]
  },
  "mixins": [
    "explosionoverhaul.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21.1",
